# =============================================================================
# PEDV — Sistema Jurídico
# Variáveis de ambiente necessárias para o deploy
#
# INSTRUÇÃO: copie este arquivo para .env.local (desenvolvimento)
#            ou configure como variáveis de ambiente na plataforma de deploy.
#
# NUNCA comite o .env.local no Git.
# =============================================================================


# ─── Supabase (OBRIGATÓRIO) ────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API

# URL do projeto Supabase (começa com https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave pública anônima (pode ser exposta no frontend — sem risco)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de service role (NUNCA exponha no frontend — apenas server-side)
# Necessária para operações administrativas (criar usuários, etc.)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─── URL da Aplicação (OBRIGATÓRIO em produção) ────────────────────────────────
# URL pública do sistema. Usado em:
#  - Links de e-mail (reset de senha, convites)
#  - Callbacks OAuth
#
# Desenvolvimento: http://localhost:3000
# Produção:        https://app.seuescritorio.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─── OpenAI (OBRIGATÓRIO se usar IA Jurídica) ──────────────────────────────────
# Encontre em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Modelo a usar (padrão: gpt-4o-mini para custo-benefício)
# Opções: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# URL base alternativa (opcional — para Azure OpenAI ou proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1


# ─── Segredo para Cron Jobs (OBRIGATÓRIO se usar monitoramento automático) ─────
# Segredo para autenticar chamadas externas ao /api/monitoramento/buscar
# Use um gerador de tokens aleatórios: openssl rand -hex 32
# ATENÇÃO: NUNCA use NEXT_PUBLIC_ nessa variável — ficaria exposto no browser
# ─── Banco Inter Empresas - Cobranca Boleto com Pix (SERVER-SIDE) ─────────────
# Use as credenciais e certificados mTLS emitidos no Portal Inter Developers.
# Em staging/preview, a URL de producao do Inter e bloqueada: use homologacao.
# NUNCA prefixe estas variaveis com NEXT_PUBLIC_.
INTER_CLIENT_ID=65ecb147-9da6-4f27-82cd-f770d87a1035
INTER_CLIENT_SECRET=4b496196-06d6-48de-a981-d943926cad94
INTER_CERT_BASE64=base64_do_certificado_mtls
INTER_KEY_BASE64=base64_da_chave_privada_mtls
INTER_WEBHOOK_CA_BASE64=base64_do_ca_do_inter
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_WEBHOOK_ENABLED=false
# Usado apenas se o webhook futuro for reativado via proxy/gateway mTLS.
INTER_WEBHOOK_SECRET=segredo_compartilhado_para_webhook
INTER_TOKEN_SCOPE=boleto-cobranca.write boleto-cobranca.read

# Compatibilidade opcional apenas em desenvolvimento local:
# INTER_CERT_PATH=C:\caminho\seguro\inter-certificado.crt
# INTER_KEY_PATH=C:\caminho\seguro\inter-chave.key
# INTER_WEBHOOK_CA_PATH=C:\caminho\seguro\inter-ca.crt

# Opcional: sobrescreva endpoints caso a versao contratada do Inter use caminhos diferentes.
# INTER_CREATE_CHARGE_PATH=/cobranca/v3/cobrancas
# INTER_GET_CHARGE_PATH=/cobranca/v3/cobrancas/{id}
# INTER_GET_CHARGE_PDF_PATH=/cobranca/v3/cobrancas/{id}/pdf
# INTER_CANCEL_CHARGE_PATH=/cobranca/v3/cobrancas/{id}/cancelar


CRON_SECRET=Peixeboidacapapreta23021979$$$$


# ─── Variáveis automáticas da Vercel (não configure manualmente) ───────────────
# A Vercel define VERCEL_URL automaticamente em cada deploy.
# O sistema usa ela como fallback para NEXT_PUBLIC_APP_URL.
# VERCEL_URL=seu-projeto.vercel.app  # ← não configure, a Vercel preenche
